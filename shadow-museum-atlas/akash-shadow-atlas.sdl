---
version: "2.0"
services:
  web:
    image: ghcr.io/prophitengine/shadow-museum-atlas:latest
    env:
      - DATABASE_URL=postgres://shadow_user:shadow_password@db:5432/shadow_atlas
    expose:
      - port: 8088
        as: 80
        to:
          - global: true
  db:
    image: postgres:15-alpine
    env:
      - POSTGRES_USER=shadow_user
      - POSTGRES_PASSWORD=shadow_password
      - POSTGRES_DB=shadow_atlas
    expose:
      - port: 5432
        as: 5432
        to:
          - service: web

profiles:
  compute:
    web:
      resources:
        cpu:
          units: 2.0
        memory:
          size: 4Gi
        storage:
          size: 5Gi
    db:
      resources:
        cpu:
          units: 2.0
        memory:
          size: 4Gi
        storage:
          size: 10Gi
  placement:
    dcloud:
      pricing:
        web:
          denom: uact
          amount: 1000
        db:
          denom: uact
          amount: 500

deployment:
  web:
    dcloud:
      profile: web
      count: 1
  db:
    dcloud:
      profile: db
      count: 1
